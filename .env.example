# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catacombs

# Discord OAuth2
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional: override Discord's API base (tests use a local mock)
# DISCORD_API_BASE=https://discord.com/api/v10

# Optional: Discord premium. When the SKU is set, the bot token is required
# (it reads the application's entitlements).
# DISCORD_PREMIUM_SKU_ID=your_premium_sku_id
# DISCORD_BOT_TOKEN=your_discord_bot_token

# Security
# Secret key for JWT signing - generate a secure random string
JWT_SECRET=your_jwt_secret_change_this_in_production

# Encryption key for storing refresh tokens at rest
# Generate a secure 32-byte base64 encoded key:
#   openssl rand -base64 32
ENCRYPTION_KEY=your-base64-encoded-32-byte-encryption-key

# Logging
RUST_LOG=info,catacombs=debug
